procedure TdmBaseDados.tblEntradaValorUnitarioChange(Sender: TField);
begin
   dmBaseDados.tblEntradaValorTotal.AsFloat := (dmBaseDados.tblEntradaQuantidade.AsFloat * dmBaseDados.tblEntradaValorUnitario.AsFloat);
end;

procedure TdmBaseDados.tblEntradaAliquotaIPIChange(Sender: TField);
var
  valorIPI : Double;
begin
   valorIPI := 0;
   valorIPI := (dmBaseDados.tblEntradaValorTotal.AsFloat * dmBaseDados.tblEntradaAliquotaIPI.AsFloat) / 100;
   dmBaseDados.tblEntradaValorComIPI.AsFloat := dmBaseDados.tblEntradaValorTotal.AsFloat + valorIPI;
end;

