procedure TdmBaseDados.tblFamiliasBeforeDelete(DataSet: TDataSet);
var
   intConfirma: integer;
begin
   intConfirma := Excluir();
   if (intConfirma <> IDYES) then
      Abort;
end;

procedure TdmBaseDados.tblContasReceberBeforeDelete(DataSet: TDataSet);
var
   intConfirma: integer;
begin
  if (Status = '' )then
   begin
   intConfirma := Excluir();
   if (intConfirma <> IDYES) then
      Abort;
   end;
end;

procedure TdmBaseDados.tblContasPagarBeforeDelete(DataSet: TDataSet);
var
   intConfirma: integer;
begin
  if formCopiaLimpeza.ckbLimpeza.Checked = False then
   begin
   intConfirma := Excluir();
   if (intConfirma <> IDYES) then
      Abort;
   end;
end;

